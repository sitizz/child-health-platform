{
  "expo": {
    "name": "Child Guard",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cg-icon.png",
    "scheme": "childguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/cg-adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.childguard.health"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/cg-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cg-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6BFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Child Guard uses your location to check local weather and air quality so it can assess environmental health risk for your child."
        }
      ],
      "expo-dev-client",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9160cbf5-17bf-4499-9170-97385281f462"
      }
    }
  }
}
