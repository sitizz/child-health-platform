APP_ENV=development
APP_NAME=Child Guard API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Comma-separated origins. Use * only in development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Shared secret you create for this API (not from Open-Meteo/Render).
# Leave empty in development to disable auth. Required when APP_ENV=production.
# Clients send header: X-API-Key: <API_KEY>
# Copy .env.example -> .env and set a real value (see openssl rand -hex 32).
API_KEY=

RATE_LIMIT=60/minute
CACHE_TTL_SECONDS=300
OPEN_METEO_TIMEOUT_SECONDS=5.0
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Optional. When unset, an in-memory cache is used.
REDIS_URL=

ENABLE_DOCS=true
MODEL_VERSION=env-risk-heuristic-v1
