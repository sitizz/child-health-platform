APP_ENV=development
APP_NAME=Child Guard API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Service gate. Leave empty in local development to disable.
API_KEY=

DATABASE_URL=postgresql+asyncpg://childguard:childguard@localhost:5432/childguard
# Host machine: use 6380 (compose maps redis 6379->6380). Inside compose network: redis://redis:6379/0
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

RATE_LIMIT=60/minute
CACHE_TTL_SECONDS=300
OPEN_METEO_TIMEOUT_SECONDS=5.0
# Optional customer key. When set, customer-* hosts are used automatically.
OPEN_METEO_API_KEY=
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality

ENABLE_DOCS=true
MODEL_VERSION=env-risk-heuristic-v2
DISCLAIMER_VERSION=disclaimer-v1
CONSENT_VERSION=consent-v1
PRIVACY_POLICY_URL=https://child-health-platform.onrender.com/privacy
TERMS_URL=https://child-health-platform.onrender.com/terms

EXPO_ACCESS_TOKEN=
NOTIFICATION_COOLDOWN_MINUTES=180
MAX_CHILDREN_PER_CAREGIVER=10
